# App
APP_NAME=Stremio HTTP Proxy
DEBUG=false
API_HOST=0.0.0.0
API_PORT=8691
PUBLIC_BASE_URL=http://localhost:8691
CACHE_BASE_URL=http://localhost:8691
APP_SECRET=
DASHBOARD_BASIC_AUTH_USER=admin
DASHBOARD_BASIC_AUTH_PASSWORD=password
CACHE_TOKEN_TTL_SECONDS=259200

# Database (MariaDB / MySQL or SQLite fallback)
DATABASE_URL=mysql+pymysql://proxy_user:proxy_password@db:3306/stremio_http_proxy?charset=utf8mb4
DB_NAME=stremio_http_proxy
DB_USER=proxy_user
DB_PASSWORD=proxy_password
DB_ROOT_PASSWORD=root_password
SQLITE_PATH=var/db/cache.sqlite

# Upstream
UPSTREAM_BASE_URL=https://example.com
REQUEST_TIMEOUT_SECONDS=20

# TorrServer
TORRSERVER_BASE_URL=http://localhost:8090
TORRSERVER_INTERNAL_URL=http://localhost:8090
TORRSERVER_BASIC_AUTH_USER=
TORRSERVER_BASIC_AUTH_PASSWORD=
TORRSERVER_HEALTH_CHECK_ENABLED=false
TORRSERVER_HEALTH_CHECK_TIMEOUT_SECONDS=15

# Logging
LOG_LEVEL=INFO
LOG_DIR=var/log

# Local Cache
CACHE_ENABLED=true
LOCAL_CACHE_DIR=var/cache
LOCAL_CACHE_MAX_AGE_DAYS=7
LOCAL_CACHE_MAX_SIZE_GB=20

# Download Worker
DOWNLOAD_QUEUE_POLL_SECONDS=1
DOWNLOAD_MAX_ATTEMPTS=3
DOWNLOAD_CONNECT_TIMEOUT_SECONDS=10
DOWNLOAD_NO_PROGRESS_TIMEOUT_SECONDS=90
DOWNLOAD_MIN_PROGRESS_BYTES=33554432
DOWNLOAD_PREFETCH_MIN_PROGRESS_BYTES=1048576
DOWNLOAD_MIN_PROGRESS_WINDOW_SECONDS=600
DOWNLOAD_MAX_TOTAL_SECONDS=43200
DOWNLOAD_PROGRESS_LOG_INTERVAL_SECONDS=10

# TMDB (optional — for media metadata enrichment)
TMDB_API_KEY=

# Episode Prefetch
NEXT_EPISODE_PREFETCH_ENABLED=true
NEXT_EPISODE_PREFETCH_STREAM_LIMIT=3
PREFETCH_TARGET_COMPLETED_PER_EPISODE=1
PREFETCH_DELAY_SECONDS=120
PREFETCH_POLL_SECONDS=15
